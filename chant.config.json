{
  "release": {
    "tag": "tsad-v{version}",
    "green": "forge-checks",
    "version": { "packages": ["packages/conformance", "packages/reference"], "ranges": "exact" },
    "publish": [{ "type": "npm", "access": "public", "packages": ["packages/conformance", "packages/reference"] }],
    "workflow": {
      "trigger": "dispatch",
      "file": ".github/workflows/publish.yml",
      "chant": "npx --yes @intentius/chant@0.124.103",
      "build": "npm run build && bash scripts/release-spec-version.sh && npm run typecheck && npm test && npm run lint:prose && npm run smoke:published"
    }
  }
}
