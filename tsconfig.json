{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "packages/**/*",
    "spec/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "docs/**"
  ]
}
