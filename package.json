{
  "name": "typescript-as-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs": "node docs/scripts/sync-spec.mjs && hugo server -s docs --bind 127.0.0.1 --port 8000 --openBrowser",
    "docs:build": "node docs/scripts/sync-spec.mjs && rm -rf docs/public && hugo -s docs --minify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "corpus": "TSAD_CORPUS_REPORT=1 vitest run packages/conformance/src/corpus.test.ts packages/conformance/src/rules.test.ts",
    "lint:prose": "node scripts/lint-docs-sentences.mjs",
    "build": "npm run build --workspaces",
    "release:preflight": "bash scripts/release-preflight.sh",
    "smoke:published": "bash scripts/smoke-published.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@intentius/chant": "0.72.0",
    "sentences": "0.1.1"
  }
}
