{
  "name": "@intentius/tsad-reference",
  "version": "1.0.0",
  "description": "The reference implementation of the typescript-as-data specification, written from the specification text and nothing else.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/INTENTIUS/typescript-as-data.git",
    "directory": "packages/reference"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "src/",
    "dist/",
    "CAVEATS.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@intentius/tsad-conformance": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
